{
    "name": "grasmash/yaml-expander",
    "description": "Expands internal property references in a yaml file.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthew Grasmick"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "grasmash/expander": "^3.0.1",
        "psr/log": "^2 || ^3",
        "symfony/yaml": "^6.4.40 || ^7.4.12 || ^8.0.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.62 || ^11.5.50 || ^12.5.8 || ^13",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "Grasmash\\YamlExpander\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Grasmash\\YamlExpander\\Tests\\": "tests/src/"
        }
    },
    "scripts": {
        "cs": "phpcs",
        "cbf": "phpcbf",
        "unit": "phpunit",
        "lint": [
            "find src -name '*.php' -print0 | xargs -0 -n1 php -l",
            "find tests -name '*.php' -print0 | xargs -0 -n1 php -l"
        ],
        "test": [
            "@lint",
            "@unit",
            "@cs"
        ],
        "coverage": "php -d pcov.enabled=1 vendor/bin/phpunit --coverage-clover build/logs/clover.xml"
    },
    "scripts-descriptions": {
        "cs": "Checks code style with PHP_CodeSniffer.",
        "cbf": "Auto-fixes code style issues.",
        "unit": "Runs PHPUnit tests.",
        "lint": "Lints all PHP files for syntax errors.",
        "test": "Runs lint, unit tests, and code sniffer.",
        "coverage": "Generates a clover coverage report."
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
